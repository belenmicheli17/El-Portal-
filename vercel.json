{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/profesional/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|google-inspectiontool|googleother|bingbot|duckduckbot|yandex|baiduspider|facebookexternalhit|twitterbot|linkedinbot|slackbot|telegrambot|whatsapp).*" }],
      "destination": "/api/seo?tipo=profesional&slug=:slug"
    },
    {
      "source": "/clinica/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|google-inspectiontool|googleother|bingbot|duckduckbot|yandex|baiduspider|facebookexternalhit|twitterbot|linkedinbot|slackbot|telegrambot|whatsapp).*" }],
      "destination": "/api/seo?tipo=clinica&slug=:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/recordatorio-onboarding", "schedule": "0 13 * * *" }
  ]
}